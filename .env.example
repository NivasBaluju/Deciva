# Copy this file to .env and adjust values before running in production.

PORT=5000

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret

# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
# Leave blank to auto-generate and persist one on first run (data/db/master.key).
AES_MASTER_KEY=

# Optional: real email delivery for OTP codes via SMTP (e.g. Gmail app password).
# If left blank, Deciva runs in DEV MODE: OTP codes are returned in the API
# response and printed to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Deciva <no-reply@deciva.ai>"

# Optional: enable real LLM-powered legal intelligence via Google Gemini.
# If left blank, Deciva uses its fast, offline, deterministic rule-based
# AI engine (clause extraction, RAG search, compliance checks, risk calculation)
# which works fully out of the box with zero external API dependencies.
# Supported key environment variable names: GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY=
# GEMINI_MODEL specifies the external model identifier (defaults to gemini-1.5-flash).
GEMINI_MODEL=gemini-1.5-flash

# Force MFA requirement across the application (true/false)
REQUIRE_MFA=true

# Database Connection (PostgreSQL 16+)
# For cloud databases (Neon, Supabase, AWS RDS), append ?sslmode=require.
# Node.js automatically normalizes sslmode=require to verify-full for strict TLS verification.
DATABASE_URL="postgresql://user:password@localhost:5432/deciva?sslmode=require"

# Inter-Service Gateway Secret (must match between Node and Python microservice)
INTERNAL_SERVICE_KEY=change_this_to_a_cryptographically_strong_shared_secret

# Initial Admin Bootstrap (comma-separated list of emails; bootstrap only, users.role is authoritative)
# ADMIN_EMAILS="admin@yourdomain.com"

# Microservice & Frontend URLs
AI_MICROSERVICE_URL=http://localhost:5001
CLIENT_URL=http://localhost:3000

# Cookie Configuration
COOKIE_SECURE=true
COOKIE_DOMAIN=

# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RSA 2048-bit Digital Signing Keys (SEC-05)
# Used for cryptographic contract signing and signature verification (signData / verifySignature).
# In production, clustered, or serverless deployments, configure matching persistent PEM keys
# to ensure signatures generated on one instance can be verified across all instances.
# Never commit real private keys to source control.
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048 && openssl rsa -pubout -in private.pem -out public.pem
# Newlines can be passed as literal \n strings in environment variables:
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...placeholder...\n-----END PRIVATE KEY-----"
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...placeholder...\n-----END PUBLIC KEY-----"

